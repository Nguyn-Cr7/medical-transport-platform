# ==============================================================================
# CAREVIA ENVIRONMENT VARIABLES EXAMPLE
# Sao chép file này thành .env.local và điền các giá trị thực tế của bạn.
# Tuyệt đối KHÔNG commit .env.local vào git hoặc đưa Service Role Key vào frontend.
# ==============================================================================

# Supabase Configuration (Lấy từ Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Tên miền website chính thức (dùng cho SEO Sitemap, Robots.txt, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://carevia.vn

# Tùy chọn: Secret key bảo vệ Route Revalidation phía Server (tùy chọn)
REVALIDATION_SECRET=your-random-revalidation-secret

# Backend Spring Boot API (nếu dùng)
NEXT_PUBLIC_API_URL=http://localhost:8080
