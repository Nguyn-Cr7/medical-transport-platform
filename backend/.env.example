# Database configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/medical_transport_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_password

# JWT secret key (must be at least 256 bits/32 characters)
JWT_SECRET=your_jwt_secret_key_must_be_at_least_32_bytes_long

# CORS frontend URL
FRONTEND_URL=http://localhost:3000

# Server Port
SERVER_PORT=8080

# Spring Active Profile (local, prod)
SPRING_PROFILES_ACTIVE=local
